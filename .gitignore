# ====== study-tracker · git 忽略 ======

# 密钥 / 环境变量 (绝对禁止入库)
.env
.env.*
!.env.example

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
build/
*.egg
.coverage
htmlcov/

# Node (仅为前端集成测试装 jsdom, 运行时不需要)
node_modules/
package-lock.json
package.json

# 数据库 (本地数据不入库)
data/study.db
data/study.db-journal
data/study.db-shm
data/study.db-wal
# 任何 study.db* 备份/临时文件 (含 .bak-pre-unicode-fix-时间戳 这类带后缀的)
data/study.db*
!data/.gitkeep

# 服务运行时产物 (PID / 日志 / 元信息)
run/

# 测试产物 / 过程留档 (artifacts 整个目录不入库)
artifacts/

# pytest 临时目录 (每轮测试会生成上百个 test_study.db)
tmp/
.pytest_tmp/

# 虚拟环境
venv/
.venv/
env/

# 设计讨论过程产物 (brainstorm 线框图/会话, 不入库)
.superpowers/

# 编辑器 / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# 导出数据 (用户本地备份, 不入库)
data/exports/
*.log

# 根目录临时烟测脚本 / 输出 (本地调试用, 不入库)
st-t.sh
st-t.txt
# 调试脚本与截图产物 (tmp_diag.py / tmp_board.png / tmp_flower_preview.py ...)
/tmp_*

# 备份文件 (*.bak-YYYYMMDD-HHMMSS 轮转产物, 不入库)
*.bak-*
!.env.example