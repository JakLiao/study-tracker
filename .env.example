# ====== study-tracker v1 · 环境变量模板 ======
# 复制为 .env 后填入真实值；.env 已加入 .gitignore，禁止入库

# ---- AI 调用 (必填, 缺失则 AI 解析不可用, 但不影响手动录入) ----
# 从 https://api.minimaxi.com 控制台获取
MINIMAX_API_KEY=your-minimax-api-key-here

# 调用的模型版本 (v1 固定, 不做切换)
MINIMAX_MODEL=MiniMax-M3

# MiniMax API base URL (国内站)
MINIMAX_API_BASE=https://api.minimaxi.com

# AI 调用超时 (秒, 默认 120)
# 依据: 实测 9.22 三科合并样本解析约 82s, 15s/60s 都会误杀
MINIMAX_TIMEOUT=120

# ---- 服务监听 (可选) ----
HOST=127.0.0.1
# 默认 8876; 8765 已被 serve_gallery.py 占用, 不要改回
PORT=8876

# ---- 数据库 (PostgreSQL, 必填) ----
# 默认指向本机 docker 容器 study-pg (127.0.0.1:5434)。
# 远端 / 生产环境直接改这一行即可, 代码里不再有 sqlite 路径。
#
# ⚠️ 这里的密码是占位符, 不是真实密码 —— 真实密码只写在 .env (已 gitignore)。
# 建容器时用的密码请自行设定, 并把同一个值填到下面两行。
DATABASE_URL=postgresql://study:CHANGE_ME@127.0.0.1:5434/study_tracker

# 测试库 (可选): 默认取 DATABASE_URL 的同实例 study_tracker_test, 避免测试清表影响真实数据
# TEST_DATABASE_URL=postgresql://study:CHANGE_ME@127.0.0.1:5434/study_tracker_test

# 历史 SQLite 文件 (仅一次性数据导入 / 归档用, 运行时不再读写)
# STUDY_DB_PATH=./data/study.db